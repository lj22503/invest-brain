{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvestBrain",
  "version": "0.1.0",
  "identifier": "com.investbrain.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "InvestBrain",
        "url": "chat",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
