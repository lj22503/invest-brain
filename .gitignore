# Next.js
frontend/.next/
frontend/node_modules/
.next/
node_modules/

# Python
__pycache__/
*.py[cod]
.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Industry frameworks (private IP, served via vector store / RAG only)
data/industry/*.md
!data/industry/申万28个行业分类.json

# Chroma vector index (auto-regenerated on first run, ~80MB embedding download)
data/vectors/

# Runtime config with secrets (user-provided, set via env vars or local override)
data/config/*.json

# User memory database (private per CLAUDE.md decision: local-only, never upload)
data/memory/*.db

# Local ONNX models (large binary files, download separately)
models/

# Task tracking (internal only, not for public repo)
status.json
docs/
.superpowers/

# Next.js app build artifacts (regenerable, not for repo)
app/.next/
app/out/
app/next-env.d.ts

# Next.js export _next/ chunks (hashed, change every build — already committed once in fb2a64d but gitignore for future builds)
desktop/ui/_next/

# MCP key / secret file (user-provided; never commit, never sample into docs)
mcp-key.txt

# MCP bundle binary (build artifact, rebuild via release script)
*.mcpb

# MCP publisher CLI (29MB binary, re-download when needed)
mcp-publisher.exe

# MCP registry tokens (used by mcp-publisher to authenticate; never commit)
.mcpregistry_*

# MCP login flow one-time output (device code, expires after use)
login_output.txt

# Historical audit residue
.impeccable/
